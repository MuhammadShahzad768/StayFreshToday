---
import Layout from "../layouts/Layout.astro";
const SiteName = import.meta.env.SITE_NAMEb || "https://admin.stayfreshtoday.com";
const response = await fetch(
  `${SiteName}/wp-json/wp/v2/pages?slug=contact-us`
);

const About = await response.json();

const title = About[0]?.title?.rendered || "About";
const content = About[0]?.content?.rendered || "";

// Get Rank Math SEO
const seoRes = await fetch(
  `${SiteName}/wp-json/rankmath/v1/getHead?url=${encodeURIComponent(`${SiteName}/contact-us`)}`
);

const seo = await seoRes.json();

---

<Layout title={About[0].title.rendered } seoHead={seo.head}>
  <section class="max-w-7xl px-4 sm:px-6 lg:px-8  m-auto ">
  <h1 class="mb-12 text-center text-4xl font-bold text-[#025831]">{title}</h1>
  <div class="font-size prose prose-lg dark:prose-invert max-w-none text-black dark:text-neutral-100 flex flex-col gap-5 font-[30px]" set:html={content}></div>
</section>
</Layout>
<style is:global>
.font-size p{
    font-size: 1.125rem;
}
 .td-blog-fitness {
    letter-spacing: .02rem;
}
main a {
    color: #007e43;
    text-decoration: none;
}
    </style>