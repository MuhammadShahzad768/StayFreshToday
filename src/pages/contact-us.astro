---
import Layout from "../layouts/Layout.astro";

const response = await fetch(
  "https://stayfreshtoday.com/wp-json/wp/v2/pages?slug=contact-us"
);

const About = await response.json();

const title = About[0]?.title?.rendered || "About";
const content = About[0]?.content?.rendered || "";

// Get Rank Math SEO
const seoRes = await fetch(
  "https://stayfreshtoday.com/wp-json/rankmath/v1/getHead?url=https://stayfreshtoday.com/contact-us/"
);

const seo = await seoRes.json();

console.log("SEO:", seo);
---

<Layout title={About[0].title.rendered } seoHead={seo.head}>
  <h1 class="mb-12 text-center text-4xl font-bold">{title}</h1>
  <div class="font-size prose prose-lg dark:prose-invert max-w-none text-black dark:text-neutral-100 flex flex-col gap-5 font-[30px]" set:html={content}></div>

</Layout>
<style is:global>
.font-size p{
    font-size: 1.125rem;
}
 .td-blog-fitness {
    letter-spacing: .02rem;
}
main a {
    color: #007e43;
    text-decoration: none;
}
    </style>