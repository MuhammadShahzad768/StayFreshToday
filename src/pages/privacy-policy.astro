---
import Layout from "../layouts/Layout.astro";
import { marked } from "marked";
const SiteName = import.meta.env.SITE_NAMEb || "https://admin.stayfreshtoday.com";
const response = await fetch(
  `${SiteName}/wp-json/wp/v2/pages?slug=privacy-policy`
);

const PrivacyPolicy = await response.json();

const title = PrivacyPolicy[0]?.title?.rendered || "Privacy Policy";

function fixEncoding(text) {
  return text
    .replace(/�/g, "")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")  
    .replace(/&gt;/g, ">")
    .replace(/&#8217;/g, "’")
    .replace(/&#8216;/g, "‘")
    .replace(/&#8220;/g, "“")
    .replace(/&#8221;/g, "”")
    .replace(/&#8211;/g, "–")
    .replace(/&#8212;/g, "—");
}




const rawContent = PrivacyPolicy[0]?.content?.rendered || "";
const content = fixEncoding(rawContent);


// Get Rank Math SEO
const seoRes = await fetch(
  `${SiteName}/wp-json/rankmath/v1/getHead?url=${encodeURIComponent(
    `${SiteName}/privacy-policy/`
  )}`
);

const seo = await seoRes.json();

---

<Layout title={title} seoHead={seo.head} >
<div class="max-w-7xl px-4 sm:px-6 lg:px-8 m-auto">
  <h1 class="mb-12 text-center text-4xl font-bold text-[#025831]">
    {title}
  </h1>

  <div
    class="font-size prose prose-lg  max-w-none text-black flex flex-col gap-5"
    set:html={content}
  >
  </div>
</div>
</Layout>


<style is:global>
.font-size p {
  font-size: 1.125rem;
}
</style>