---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {

  const response = await fetch(
    "https://stayfreshtoday.com/wp-json/wp/v2/posts?per_page=100&_embed"
  );

  const posts = await response.json();

  return posts.map((post, index) => ({
    params: {
      slug: post.slug
    },
    props: {
      post,
      posts,
      index
    }
  }));
}

const { post, posts, index } = Astro.props;

const previousPost = posts[index + 1];
const nextPost = posts[index - 1];

// 2. Get Rank Math SEO
const seoRes = await fetch(
  `https://stayfreshtoday.com/wp-json/rankmath/v1/getHead?url=${encodeURIComponent(post.link)}`
);

const seo = await seoRes.json();
---
<html>
<body>
<Layout title={post.title.rendered} seoHead={seo.head}>
    <button id="open-toc-button" aria-label="Open table of contents" class="fixed top-24 right-6 z-30 flex size-12 cursor-pointer items-center justify-center rounded-lg bg-neutral-900 text-white shadow-sm transition duration-250 ease-out hover:bg-neutral-700 active:scale-95 dark:bg-neutral-100 dark:text-black dark:hover:bg-neutral-50"> <svg width="1em" height="1em" class="size-6" data-icon="lucide:list">   <symbol id="ai:lucide:list" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h.01M3 12h.01M3 19h.01M8 5h13M8 12h13M8 19h13"></path></symbol><use href="#ai:lucide:list"></use>  </svg> </button>
<article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 pt-0">  <div data-pagefind-body=""> <!-- Header --> <header class="mb-12">  <h1 data-pagefind-meta="title" class="mb-6 text-4xl font-bold sm:text-5xl sm:leading-snug" set:html={post.title.rendered}></h1>
     <div class="flex flex-wrap gap-6 text-gray-700 dark:text-gray-300"> <div class="flex items-center gap-2"> <svg width="1em" height="1em" class="size-5" data-icon="lucide:user-pen">   <symbol id="ai:lucide:user-pen" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M11.5 15H7a4 4 0 0 0-4 4v2m18.378-4.374a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"></path><circle cx="10" cy="7" r="4"></circle></g></symbol><use href="#ai:lucide:user-pen"></use>  </svg> 
      <span>
  {post._embedded.author[0].name || "Unknown Author"}
</span>
    </div> <div class="flex items-center gap-2"> <svg width="1em" height="1em" class="size-5" data-icon="lucide:calendar">   <symbol id="ai:lucide:calendar" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M8 2v4m8-4v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></g></symbol><use href="#ai:lucide:calendar"></use>  </svg> <span> <time datetime="2025-08-07T08:41:00.000Z"> {new Date(post.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
         day: "numeric",
        })}
        </time>   </span> </div> </div> <div class="flex items-center gap-2 mt-6"> <svg width="1em" height="1em" class="text-gray-700 dark:text-gray-300" data-icon="lucide:link">   <symbol id="ai:lucide:link" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></g></symbol><use href="#ai:lucide:link"></use>  </svg> <!-- href={`/search?series=${encodeURIComponent(series)}`} --> <span data-pagefind-filter="series" class="relative inline-block active:scale-95 text-sm font-medium underline underline-offset-4">{post._embedded["wp:term"][0][0].name} </span> </div> 
        <div class="relative overflow-hidden bg-neutral-200 dark:bg-neutral-700 mt-6 aspect-video rounded-xl"> <img data-pagefind-ignore="" src={post._embedded["wp:featuredmedia"][0].source_url} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-105 object-cover blur-xl transition duration-250 ease-out group-hover:scale-105 group-active:scale-105 medium-zoom-image" loading="eager" decoding="async"> <img class="astro-cloudinary-cldimage absolute inset-0 h-full w-full object-cover transition duration-250 ease-out group-hover:scale-105 group-active:scale-105 medium-zoom-image" alt={post._embedded["wp:featuredmedia"][0].alt_text} loading="eager" fetchpriority="high" data-pagefind-meta="image[src], image_alt[alt]"  decoding="async" style="object-fit:cover;width:100%"  src={post._embedded["wp:featuredmedia"][0].source_url}> </div> </header> <!-- Content --> <div class="prose prose-lg dark:prose-invert max-w-none text-black dark:text-neutral-100 flex flex-col gap-5" set:html={post.content.rendered}>    </div> </div>   
        <nav class="mt-12 pt-6"><div class="flex flex-col-reverse gap-6 md:grid md:grid-cols-2">
          {previousPost && (
  <a
    href={`/blog/${previousPost.slug}`}
    class="group flex flex-col rounded-lg border border-neutral-200 p-6 transition duration-250 hover:border-blue-500 active:scale-95 dark:border-neutral-700 dark:hover:border-yellow-400"
  >
    <span class="mb-2 text-sm text-gray-700 dark:text-gray-300">
      ← Previous blog
    </span>

    <span class="text-lg font-medium transition-colors duration-250 group-hover:text-blue-500 dark:group-hover:text-yellow-400">
      ← {previousPost.title.rendered}
    </span>
  </a>
)}

{nextPost && (
  <a
    href={`/blog/${nextPost.slug}`}
    class="group flex flex-col rounded-lg border border-neutral-200 p-6 transition duration-250 hover:border-blue-500 active:scale-95 dark:border-neutral-700 dark:hover:border-yellow-400"
  >
    <span class="mb-2 text-sm text-gray-700 dark:text-gray-300">
      Next blog →
    </span>

    <span class="text-lg font-medium transition-colors duration-250 group-hover:text-blue-500 dark:group-hover:text-yellow-400">
      {nextPost.title.rendered} →
    </span>
  </a>
)}</div></nav>  
    </article>
<toc-sidebar> <aside id="toc-sidebar" class="fixed top-16 right-0 z-50 h-[calc(100vh-4rem)] w-full max-w-xs overflow-y-auto bg-white p-8 shadow-xl transition-transform duration-300 ease-in-out sm:w-80 lg:w-96 dark:bg-neutral-800"> <nav id="toc"> <div class="mb-4 flex items-center justify-between"> <h2 class="text-lg font-semibold tracking-wider text-neutral-900 uppercase dark:text-white">
On this page
</h2> <button id="close-toc-button" aria-label="Close table of contents" class="relative inline-block cursor-pointer rounded-full text-neutral-600 transition duration-250 ease-out before:absolute before:-inset-x-1.75 before:-inset-y-2.5 before:content-[''] hover:text-blue-500 active:scale-95 dark:text-neutral-400 dark:hover:text-yellow-400"> <svg width="1em" height="1em" viewBox="0 0 24 24" class="size-6" data-icon="lucide:x">   <use href="#ai:lucide:x"></use>  </svg> </button> </div> <ul id='on_page'> <li class="toc-item-wrapper" data-depth="2">  </li><li class="toc-item-wrapper" data-depth="2"> </li><li class="toc-item-wrapper" data-depth="2"> <a href="#youve-delivered-now-what" data-slug="youve-delivered-now-what" class="relative block truncate py-1.5 transition duration-250 ease-out hover:text-blue-600 dark:text-gray-300 dark:hover:text-yellow-400 pl-3"> You’ve Delivered. Now What? </a> <ul class="mt-1"> <li class="toc-item-wrapper" data-depth="3"> <a href="#final-step-of-the-series" data-slug="final-step-of-the-series" class="relative block truncate py-1.5 transition duration-250 ease-out hover:text-blue-600 dark:text-gray-300 dark:hover:text-yellow-400 pl-3"> Final Step of the Series </a>  </li> </ul> </li> </ul> </nav> </aside> </toc-sidebar>
<div id="overlay" class="fixed inset-0 z-40 bg-black/50 transition-all duration-500 opacity-0 invisible pointer-events-none"></div>
<script>
  const openBtn = document.getElementById("open-toc-button");
  const closeBtn = document.getElementById("close-toc-button");
  const sidebar = document.getElementById("toc-sidebar");


  const openSidebar = () => {
    sidebar?.classList.remove("translate-x-full");
  };


  const closeSidebar = () => {
    sidebar?.classList.add("translate-x-full");
  };


  openBtn?.addEventListener("click", openSidebar);

  closeBtn?.addEventListener("click", closeSidebar);


  document.addEventListener("keydown", (e) => {
    if(e.key === "Escape"){
      closeSidebar();
    }
  });


  sidebar?.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", closeSidebar);
  });
document.addEventListener("DOMContentLoaded", () => {

  const ezContainer = document.querySelector("#ez-toc-container .ez-toc-list");
  const ez = ezContainer?.innerHTML || "";

  const onpage = document.querySelector("#on_page");

  if (onpage) {
    onpage.innerHTML = ez;

    document.querySelectorAll("#on_page li").forEach((li) => {
      li.className = "";
      li.classList.add("toc-item-wrapper");
    });

    document.querySelectorAll("#on_page li a").forEach((a) => {
      a.className = "";
      a.classList.add(
        "relative",
        "block",
        "truncate",
        "py-1.5",
        "transition",
        "duration-250",
        "ease-out",
        "hover:text-blue-600",
        "dark:text-gray-300",
        "dark:hover:text-yellow-400",
        "pl-3"
      );
    });

    // Clear original TOC
    document.querySelector("#ez-toc-container").innerHTML = "";
  }
 
const on_page = document.querySelectorAll("#on_page a");

on_page.forEach((a) => {
  let href = a.getAttribute("href");

  if (href) {
    a.setAttribute(
      "href",
      href.replace("https://stayfreshtoday.com/","http://localhost:4321/blog/")
    );
  }

  console.log("Text:", a.innerText);
  console.log("Link:", a.href);
});
});
document.querySelectorAll("#on_page a").forEach((a) => {
  a.addEventListener("click", (e) => {
    const targetId = a.getAttribute("href");

    if (targetId && targetId.startsWith("#")) {
      e.preventDefault();

      const target = document.querySelector(targetId);

      if (target) {
        target.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }
    }
  });
});
</script>
</Layout>
</body>
</html>