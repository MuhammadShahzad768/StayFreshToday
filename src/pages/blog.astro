---
import Layout from "../layouts/Layout.astro";
const SiteName = import.meta.env.SITE_NAME;
const response = await fetch(
  `${SiteName}/wp-json/wp/v2/posts?per_page=100&_embed` 
);

const posts = await response.json();

const postsJson = JSON.stringify(posts);
---

<Layout title="Blogs | Skincare & Haircare | Health & Nutrition Tips | Stayfreshtoday.com">

<section class="max-w-7xl px-4 sm:px-6 lg:px-8 m-auto">

<div class="mb-12 flex items-center justify-center">
<h2 class="text-center text-4xl font-bold text-[#025831] ">Blogs</h2>
</div>


<div 
id="posts"
class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-1 lg:grid-cols-3"
>
</div>


<div class="flex justify-center items-center gap-4 mt-10">

<button id="prev" class="px-4 py-2 bg-gray-200 rounded">
Previous
</button>

<span id="pageNumber"></span>

<button id="next" class="px-4 py-2 bg-gray-200 rounded">
Next
</button>

</div>


</section>


<script define:vars={{ posts }}>

const allPosts = posts;

const perPage = 9;

let currentPage = 1;

const totalPages = Math.ceil(allPosts.length / perPage);


const container = document.querySelector("#posts");
const pageNumber = document.querySelector("#pageNumber");


function renderPosts(){

const start = (currentPage - 1) * perPage;

const currentPosts = allPosts.slice(
start,
start + perPage
);


container.innerHTML = currentPosts.map(post => `

<article class="group relative flex flex-col">

<div class="relative overflow-hidden bg-neutral-200 dark:bg-neutral-700 mb-4 aspect-video rounded-lg">

<img
class="absolute inset-0 h-full w-full object-cover transition duration-250 ease-out group-hover:scale-105"
src="${post._embedded['wp:featuredmedia']?.[0]?.source_url || ''}"
alt="${post._embedded['wp:featuredmedia']?.[0]?.alt_text || ''}"
loading="lazy"
/>

</div>


<h3 class="mb-2 line-clamp-2 text-xl font-semibold transition-colors duration-250 ease-out group-hover:text-[#025831] group-hover:underline">

<a href="/blog/${post.slug}"
class="after:absolute after:inset-0 after:content-['']">

${post.title.rendered}

</a>

</h3>


<p class="line-clamp-3 text-gray-700 dark:text-gray-300">

${post.excerpt.rendered
.replace(/<[^>]*>/g,'')
.split(" ")
.slice(0,10)
.join(" ")}...

</p>


<div class="mt-3 text-sm text-gray-700 dark:text-gray-300">

${new Date(post.date).toLocaleDateString("en-US",{
year:"numeric",
month:"short",
day:"numeric"
})}

</div>


</article>

`).join("");



pageNumber.innerHTML = 
`Page ${currentPage} of ${totalPages}`;

}



document.querySelector("#next").onclick = ()=>{

if(currentPage < totalPages){

currentPage++;

renderPosts();

}

};



document.querySelector("#prev").onclick = ()=>{

if(currentPage > 1){

currentPage--;

renderPosts();

}

};


renderPosts();

</script>

</Layout>