
---
const response = await fetch(
  "https://stayfreshtoday.com/wp-json/wp/v2/posts?&_embed"
);

const posts = await response.json();
import Layout from "../layouts/Layout.astro";
---
<Layout title="Blogs | Skincare &amp; Haircare | Health &amp; Nutrition Tips | Stayfreshtoday.com">
<section class='max-w-7xl px-4 sm:px-6 lg:px-8  m-auto '> <div class="mb-12 flex items-center justify-between "> <h2 class="text-3xl font-bold">Blogs</h2> 
   </div> <div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-1 lg:grid-cols-3"> 
        {posts.map((post) => (
<article class="group relative flex flex-col">  <div class="relative overflow-hidden bg-neutral-200 dark:bg-neutral-700 mb-4 aspect-video rounded-lg"> <img class="astro-cloudinary-cldimage absolute inset-0 h-full w-full object-cover transition duration-250 ease-out group-hover:scale-105 group-active:scale-105" 
alt={post._embedded["wp:featuredmedia"][0].alt_text}
loading="lazy" sizes="(max-width: 768px) 100vw, 33vw"  decoding="async" style="object-fit:cover;max-width:1600px;max-height:900px;aspect-ratio:1.7777777777777777;width:100%"  src={post._embedded["wp:featuredmedia"][0].source_url}> 
 </div> 
 <h3 class="mb-2 line-clamp-2 text-xl font-semibold transition-colors duration-250 ease-out group-hover:text-blue-500 group-active:text-blue-500 dark:group-hover:text-yellow-400 dark:group-active:text-yellow-400"> <a href={`/blog/${post.slug}`}  class="after:absolute after:inset-0 after:content-['']" title={post.title.rendered}>{post.title.rendered}</a> 
 </h3> 
<span>
   <p class="line-clamp-3 text-gray-700 dark:text-gray-300">
  {post.excerpt.rendered
    .replace(/<[^>]*>/g, '')
    .split(' ')
    .slice(0, 10)
    .join(' ')}...
</p>
</span>
<div class="mt-3.5 flex flex-col items-start gap-y-4"> <div class="flex items-center gap-2 relative z-10"> 
</div> 
{/* <div class="flex flex-wrap gap-2 relative z-10"> <span class="rounded-md bg-neutral-200 px-2 py-1 text-sm text-neutral-950 dark:bg-neutral-700 dark:text-neutral-50"> client management </span><span class="rounded-md bg-neutral-200 px-2 py-1 text-sm text-neutral-950 dark:bg-neutral-700 dark:text-neutral-50"> sales and conversion </span><span class="rounded-md bg-neutral-200 px-2 py-1 text-sm text-neutral-950 dark:bg-neutral-700 dark:text-neutral-50"> social proof </span> </div>  */}

<div class="flex items-center gap-x-2 text-sm text-gray-700 dark:text-gray-300"> <time datetime="2025-08-07T08:41:00.000Z"> {new Date(post.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })}</time>  <span>·</span></div> </div> </article>
))}
</div> </section>
</Layout>