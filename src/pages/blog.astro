---

<Layout title="Blogs | Skincare & Haircare | Health & Nutrition Tips | Stayfreshtoday.com" seoHead={seoData}>

  <section class="max-w-7xl px-4 sm:px-6 lg:px-8 m-auto">

    <!-- Heading -->
    <div class="mb-12 flex items-center justify-center">
      <h2 class="text-center text-4xl font-bold text-[#025831]">
        Blogs
      </h2>
    </div>


    <!-- Posts -->
    <div
      id="posts"
      class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-1 lg:grid-cols-3"
    >
    </div>


    <!-- Pagination -->
    <div
      id="pagination"
      class="hidden justify-center items-center gap-4 mt-10"
    >

      <button
        id="prev"
        class="px-4 py-2 bg-gray-200 rounded disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Previous
      </button>

      <span id="pageNumber"></span>

      <button
        id="next"
        class="px-4 py-2 bg-gray-200 rounded disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Next
      </button>

    </div>

  </section>


  <script define:vars={{ posts }}>

    const allPosts = posts;

    const perPage = 9;

    let currentPage = 1;

    const totalPages = Math.ceil(allPosts.length / perPage);


    // Elements
    const container = document.querySelector("#posts");
    const pageNumber = document.querySelector("#pageNumber");
    const pagination = document.querySelector("#pagination");
    const prevButton = document.querySelector("#prev");
    const nextButton = document.querySelector("#next");


    // Render posts
    function renderPosts() {

      const start = (currentPage - 1) * perPage;

      const currentPosts = allPosts.slice(
        start,
        start + perPage
      );


      container.innerHTML = currentPosts.map(post => `

        <article class="group relative flex flex-col">

          <!-- Featured Image -->
          <div
            class="relative overflow-hidden bg-neutral-200  mb-4 aspect-video rounded-lg"
          >

            <img
              class="absolute inset-0 h-full w-full object-cover transition duration-250 ease-out group-hover:scale-105"
              src="${post._embedded?.['wp:featuredmedia']?.[0]?.source_url || ''}"
              alt="${post._embedded?.['wp:featuredmedia']?.[0]?.alt_text || ''}"
              loading="lazy"
            />

          </div>


          <!-- Title -->
          <h3
            class="mb-2 line-clamp-2 text-xl font-semibold transition-colors duration-250 ease-out group-hover:text-[#025831] group-hover:underline"
          >

            <a
              href="/blog/${post.slug}"
              class="after:absolute after:inset-0 after:content-['']"
            >
              ${post.title?.rendered || ""}
            </a>

          </h3>


          <!-- Excerpt -->
          <p class="line-clamp-3 text-gray-700 ">

            ${
              post.excerpt?.rendered
                ?.replace(/<[^>]*>/g, "")
                .split(" ")
                .slice(0, 10)
                .join(" ") || ""
            }...

          </p>


          <!-- Date -->
          <div class="mt-3 text-sm text-gray-700 ">

            ${
              post.date
                ? new Date(post.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric"
                  })
                : ""
            }

          </div>

        </article>

      `).join("");


      /*
       * Pagination
       *
       * Agar total pages 1 hain
       * to pagination hidden rahegi.
       */
      if (totalPages > 1) {

        pagination.classList.remove("hidden");
        pagination.classList.add("flex");

        pageNumber.textContent =
          `Page ${currentPage} of ${totalPages}`;

        // Previous button
        prevButton.disabled = currentPage === 1;

        // Next button
        nextButton.disabled = currentPage === totalPages;

      } else {

        pagination.classList.add("hidden");
        pagination.classList.remove("flex");

      }

    }


    // Next button
    nextButton.addEventListener("click", () => {

      if (currentPage < totalPages) {

        currentPage++;

        renderPosts();

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });

      }

    });


    // Previous button
    prevButton.addEventListener("click", () => {

      if (currentPage > 1) {

        currentPage--;

        renderPosts();

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });

      }

    });


    // Initial render
    renderPosts();

  </script>

</Layout>