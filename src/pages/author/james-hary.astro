---
// src/pages/author/[name].astro

import Layout from "../../layouts/Layout.astro";
const seoData = `
<!-- Search Engine Optimization by Rank Math PRO - https://rankmath.com/ -->
<meta name="description" content="Welcome to Stayfreshtoday.com! My name is James Henry, and I am a seasoned nutritionist with over a decade of experience in the field."/>
<meta name="robots" content="follow, noindex"/>
<meta property="og:locale" content="en_US" />
<meta property="og:type" content="profile" />
<meta property="og:title" content="James Henry - Stay Fresh Today" />
<meta property="og:description" content="Welcome to Stayfreshtoday.com! My name is James Henry, and I am a seasoned nutritionist with over a decade of experience in the field." />
<meta property="og:url" content="https://stayfreshtoday.com/author/james-henry/" />
<meta property="og:site_name" content="Stay Fresh Today" />
<meta property="og:image" content="https://stayfreshtoday.com/wp-content/uploads/2024/07/Stay-Fresh-Today.jpg" />
