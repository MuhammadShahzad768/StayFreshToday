<meta property="og:image:width" content="1500" />
<meta property="og:image:height" content="788" />
<meta property="og:image:type" content="image/jpeg" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="James Henry - Stay Fresh Today" />
<meta name="twitter:description" content="Welcome to Stayfreshtoday.com! My name is James Henry, and I am a seasoned nutritionist with over a decade of experience in the field." />
<meta name="twitter:image" content="https://stayfreshtoday.com/wp-content/uploads/2024/07/Stay-Fresh-Today.jpg" />
<meta name="twitter:label1" content="Name" />
<meta name="twitter:data1" content="James Henry" />
<meta name="twitter:label2" content="Posts" />
<meta name="twitter:data2" content="173" />
<script type="application/ld+json" class="rank-math-schema-pro">{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://stayfreshtoday.com/#person","name":"Stay Fresh Today","image":{"@type":"ImageObject","@id":"https://stayfreshtoday.com/#logo","url":"https://stayfreshtoday.com/wp-content/uploads/2024/07/Stay-Fresh-Today.png","contentUrl":"https://stayfreshtoday.com/wp-content/uploads/2024/07/Stay-Fresh-Today.png","caption":"Stay Fresh Today","inLanguage":"en-US","width":"252","height":"252"}},{"@type":"WebSite","@id":"https://stayfreshtoday.com/#website","url":"https://stayfreshtoday.com","name":"Stay Fresh Today","publisher":{"@id":"https://stayfreshtoday.com/#person"},"inLanguage":"en-US"},{"@type":"BreadcrumbList","@id":"https://stayfreshtoday.com/author/james-henry/#breadcrumb","itemListElement":[{"@type":"ListItem","position":"1","item":{"@id":"https://stayfreshtoday.com","name":"Home"}}]},{"@type":"ProfilePage","@id":"https://stayfreshtoday.com/author/james-henry/#webpage","url":"https://stayfreshtoday.com/author/james-henry/","name":"James Henry - Stay Fresh Today","isPartOf":{"@id":"https://stayfreshtoday.com/#website"},"inLanguage":"en-US","breadcrumb":{"@id":"https://stayfreshtoday.com/author/james-henry/#breadcrumb"}},{"@type":"Person","@id":"https://stayfreshtoday.com/author/james-henry/","name":"James Henry","description":"Welcome to Stayfreshtoday.com! My name is James Henry, and I am a seasoned nutritionist with over a decade of experience in the field.","url":"https://stayfreshtoday.com/author/james-henry/","image":{"@type":"ImageObject","@id":"https://secure.gravatar.com/avatar/e5be98a1b74e4b123bae680779ece8378e7d05e4472c5d0acb36d555262e1613?s=96&amp;d=mm&amp;r=g","url":"https://secure.gravatar.com/avatar/e5be98a1b74e4b123bae680779ece8378e7d05e4472c5d0acb36d555262e1613?s=96&amp;d=mm&amp;r=g","caption":"James Henry","inLanguage":"en-US"},"sameAs":["https://www.quora.com/profile/James-Henry-1204"],"mainEntityOfPage":{"@id":"https://stayfreshtoday.com/author/james-henry/#webpage"}}]}</script>
<!-- /Rank Math WordPress SEO plugin -->
`;
export async function getStaticPaths() {
  return [
    {
      params: {
        name: "james-hary",
      },
    },
  ];
}


const { name } = Astro.params;


const response = await fetch(
  `https://stayfreshtoday.com/wp-json/custom/v1/author/5`
);


if (!response.ok) {
  throw new Error(`Failed to fetch author`);
}


const avatorImg =
  "https://stayfreshtoday.com/wp-content/uploads/2024/05/Dr._James_Henry.jpg";


const { author, posts } = await response.json();

---


<Layout 
  title={`About ${author.name}`}
  description={author.description} seoHead={seoData}
>


<main class="max-w-7xl px-4 sm:px-6 lg:px-8 m-auto">


<!-- Author Section -->

<section class="flex flex-col items-center text-center gap-4 mb-14">


<img
  src={avatorImg}
  alt={author.name}
  class="h-28 w-28 rounded-full object-cover ring-2 ring-neutral-200"
  loading="eager" style="
    width: 100px;
    height: 100px;
"
/>


<div>

<h1 class="text-2xl font-semibold">
{author.name}
</h1>


<p class="text-sm text-gray-600">
{author.role}
</p>


</div>



<div 
class="max-w-4xl text-gray-700 leading-relaxed font-[17px]"
set:html={author.description + " " +  "With a foundation in nutrition and health sciences, I specialize in crafting personalized plans tailored to individual needs. Through workshops, consultations, and publications, I advocate for a holistic approach to well-being, addressing physical, mental, and emotional aspects. StayFreshToday.com serves as a platform to share practical tips and resources, empowering you to make sustainable lifestyle choices. Join me on this journey to a healthier, happier you."}
/>


</section>




<!-- Author Posts -->

<section class="mt-12">


<h2 class="mb-10 text-center text-4xl font-bold text-[#025831]">
Posts by {author.name}
</h2>




<div 
id="posts-container"
class="grid grid-cols-1 gap-x-8 gap-y-10 lg:grid-cols-3"
>


{
posts.map((post,index)=>(

<article
class="post-card group relative flex flex-col"
data-index={index}
>


<div class="relative overflow-hidden bg-neutral-200 mb-4 aspect-video rounded-lg">


<img
src={post.featured_image}
alt={post.title}
loading="lazy"
class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-105"
/>


</div>




<h3 class="mb-2 line-clamp-2 text-xl font-semibold transition-colors duration-250 ease-out group-hover:text-[#025831] group-hover:underline">


<a 
href={`/blog/${post.slug}`}
class="after:absolute after:inset-0 after:content-['']"
>

{post.title}

</a>


</h3>




<p class="line-clamp-3 text-gray-700">

{post.excerpt.split(" ").slice(0,10).join(" ")}

</p>



<div class="mt-3 text-sm text-gray-600">

{new Date(post.date).toLocaleDateString(
"en-US",
{
month:"short",
day:"numeric",
year:"numeric"
}
)}

</div>



</article>


))

}


</div>




<!-- Pagination -->

<div 
id="pagination"
class="flex justify-center gap-3 mt-12"
>
</div>



</section>



</main>





<script define:vars={{totalPosts: posts.length}}>


const postsPerPage = 12;


const cards =
document.querySelectorAll(".post-card");


const pagination =
document.querySelector("#pagination");



const totalPages =
Math.ceil(totalPosts / postsPerPage);





function showPage(page){


cards.forEach((card,index)=>{


const start =
(page - 1) * postsPerPage;


const end =
start + postsPerPage;



if(index >= start && index < end){

card.style.display="flex";

}
else{

card.style.display="none";

}


});



document
.querySelectorAll(".page-btn")
.forEach(btn=>{

btn.classList.remove(
"font-bold",
"active-Page",
"scale-110"
);

});



const active =
document.querySelector(
`[data-page="${page}"]`
);


if(active){

active.classList.add(
"font-bold",
"scale-110",
"active-Page"
);

}


}




for(let i=1;i<=totalPages;i++){


const button =
document.createElement("button");


button.innerText=i;


button.dataset.page=i;


button.className=
`
page-btn
px-4
py-2
rounded
text-white
transition
`;



button.addEventListener("click", () => {
  showPage(i);

  document
    .querySelector("#posts-container")
    ?.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
});



pagination.appendChild(button);


}




// first page
showPage(1);


    let leading = document.querySelector(".leading-relaxed");

if (leading) {
  let strong = leading.querySelector("strong");

  if (strong) {
    strong.insertAdjacentHTML("afterend", "<br><br>");
  }
}

</script>


</Layout>
<style is:global>
    button.page-btn {
    background-color: #6AB491;
}
button.page-btn.active-Page {
    background-color: #025831;
}
</style>