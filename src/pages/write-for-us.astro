---
import Layout from "../layouts/Layout.astro";
const SiteName = import.meta.env.SITE_NAMEb || "https://admin.stayfreshtoday.com";
const response = await fetch(
  `${SiteName}/wp-json/custom/v1/write-for-us`
);

if (!response.ok) {
  throw new Error(`API Error: ${response.status}`);
}

const data = await response.json();

const seoData = data.rank_math || {};

---

<Layout title={data.title} seoHead={seoData.head}>
<div class="max-w-7xl px-4 sm:px-6 lg:px-8 m-auto">
  <div
    class="write-for-us"
    set:html={data.content}
  ></div>
  </div>
<script>
      document.addEventListener('DOMContentLoaded', function() {
            const questions = document.querySelectorAll('.question');

            questions.forEach(function(question) {
                question.addEventListener('click', function() {
                    const wasActive = question.classList.contains('active');
                    questions.forEach(q => q.classList.remove('active'));
                    if (!wasActive) {
                        question.classList.add('active');
                    }
                });
            });
        });
    </script>
</Layout>
<style is:global>
