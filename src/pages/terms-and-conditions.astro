---
import Layout from "../layouts/Layout.astro";
import { marked } from "marked";
const SiteName = import.meta.env.SITE_NAMEb || "https://admin.stayfreshtoday.com";
const response = await fetch(
  `${SiteName}/wp-json/wp/v2/pages?slug=terms-and-condiitons`
);

const TermsAndConditions = await response.json();

const title = TermsAndConditions[0]?.title?.rendered || "Terms and Conditions";

function fixEncoding(text) {
  try {
    return Buffer.from(text, "latin1").toString("utf8");
  } catch {
    return text; // agar already valid UTF-8 hai to fallback
  }
}

const rawContent = TermsAndConditions[0]?.content?.rendered || "";

const content = fixEncoding(rawContent);

// Get Rank Math SEO
const seoRes = await fetch(
  `${SiteName}/wp-json/rankmath/v1/getHead?url=${encodeURIComponent(
    `${SiteName}/terms-and-condiitons/`
  )}`
);

const seo = await seoRes.json();

---

<Layout title={title} seoHead={seo.head}>
<div class="max-w-7xl px-4 sm:px-6 lg:px-8 m-auto">
  <h1 class="mb-12 text-center text-4xl font-bold text-[#025831]">
    {title}
  </h1>

  <div
    class="font-size prose prose-lg  max-w-none text-black  flex flex-col gap-5"
    set:html={content}
  >
  </div>
</div>
</Layout>


<style is:global>
.font-size p {
  font-size: 1.125rem;
}
</style>