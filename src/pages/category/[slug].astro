---
import Layout from "../../layouts/Layout.astro";


export async function getStaticPaths() {

  const response = await fetch(
    "https://stayfreshtoday.com/wp-json/wp/v2/categories"
  );

  const categories = await response.json();


  return categories.map((category) => ({
    params:{
      slug: category.slug
    },
    props:{
      category
    }
  }));

}


const { category } = Astro.props;


const postsResponse = await fetch(
  `https://stayfreshtoday.com/wp-json/wp/v2/posts?categories=${category.id}&_embed`
);


const posts = await postsResponse.json();

---

<Layout title={category.name}>
<h1 class="mb-12 text-center text-4xl font-bold">{category.name}</h1>
<div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3"> 
    {posts.map((post) => (
    <article class="group relative flex flex-col">  <div class="relative overflow-hidden bg-neutral-200 dark:bg-neutral-700 mb-4 aspect-video rounded-lg"> <img data-pagefind-ignore="" src="https://res.cloudinary.com/dellp9a4z/image/upload/w_20,e_blur:1000,q_1,f_auto/v1756655991/testimonials_zufmeq.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-105 object-cover blur-xl transition duration-250 ease-out group-hover:scale-105 group-active:scale-105" loading="eager" decoding="async"> <img class="astro-cloudinary-cldimage absolute inset-0 h-full w-full object-cover transition duration-250 ease-out group-hover:scale-105 group-active:scale-105" alt="A hand-drawn charcoal sketch on brown paper. A happy, glowing cartoon character labeled 'CLIENT' is giving a shining seed labeled 'TESTIMONIAL' to another character. This second character is smiling as they kneel in a garden, planting a seedling. In the background, several small plants with smiling faces are sprouting from the ground, labeled 'NEW CLIENTS'." loading="lazy" sizes="(max-width: 768px) 100vw, 33vw" data-cldimage-src="https://res.cloudinary.com/dellp9a4z/image/upload/v1756655991/testimonials_zufmeq.webp" decoding="async" style="object-fit:cover;max-width:1600px;max-height:900px;aspect-ratio:1.7777777777777777;width:100%"  src={post._embedded["wp:featuredmedia"][0].source_url}> </div> <h3 class="mb-2 line-clamp-2 text-xl font-semibold transition-colors duration-250 ease-out group-hover:text-blue-500 group-active:text-blue-500 dark:group-hover:text-yellow-400 dark:group-active:text-yellow-400"> 
    <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0 after:content-['']">{post.title.rendered}</a> </h3> <span>
   <p class="line-clamp-3 text-gray-700 dark:text-gray-300">
  {post.excerpt.rendered
    .replace(/<[^>]*>/g, '')
    .split(' ')
    .slice(0, 10)
    .join(' ')}...
</p>
</span> <div class="mt-3.5 flex flex-col items-start gap-y-4"> 
    {/* <div class="flex items-center gap-2 relative z-10"> <svg width="1em" height="1em" class="text-gray-700 dark:text-gray-300" data-icon="lucide:link">   <symbol id="ai:lucide:link" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></g></symbol><use href="#ai:lucide:link"></use>  </svg> <!-- href={`/search?series=${encodeURIComponent(series)}`} --> <span data-pagefind-filter="series" class="relative inline-block active:scale-95 text-sm font-medium underline underline-offset-4"> {post._embedded["wp:term"][0][0].name}</span> </div>  */}
    {/* <div class="flex flex-wrap gap-2 relative z-10"> <span class="rounded-md bg-neutral-200 px-2 py-1 text-sm text-neutral-950 dark:bg-neutral-700 dark:text-neutral-50"> client management </span><span class="rounded-md bg-neutral-200 px-2 py-1 text-sm text-neutral-950 dark:bg-neutral-700 dark:text-neutral-50"> sales and conversion </span><span class="rounded-md bg-neutral-200 px-2 py-1 text-sm text-neutral-950 dark:bg-neutral-700 dark:text-neutral-50"> social proof </span> </div>  */}
    <div class="flex items-center gap-x-2 text-sm text-gray-700 dark:text-gray-300"> <time datetime="2025-08-07T08:41:00.000Z"> {new Date(post.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })}</time> </div> </div> </article>
    
    ))}
     </div>
</Layout>