---
import Layout from "../layouts/Layout.astro";
import Banner from "../components/Home/Banner.astro";
import Categories from "../components/Home/Categories.astro";
const SiteName = import.meta.env.SITE_NAMEb || "https://stayfreshtoday.com";

const response = await fetch(
  `${SiteName}/wp-json/wp/v2/posts?per_page=3&_embed`
);

const posts = await response.json();
const seoUrl = import.meta.env.SITE_NAMEb || "stayfreshtoday.com";

const seoResponse = await fetch(
  `${SiteName}/wp-json/rankmath/v1/getHead?url=${encodeURIComponent(seoUrl)}`
);

const seoData = await seoResponse.json();

// Fetch the category ID for "Health"
const categoryResponse = await fetch(
  `${SiteName}/wp-json/wp/v2/categories?slug=health`
);
const category = await categoryResponse.json();
const healthCategoryId = category[0].id;
const postsResponse = await fetch(
  `${SiteName}/wp-json/wp/v2/posts?categories=${healthCategoryId}&_embed&per_page=3`
);
const healthPosts = await postsResponse.json();
// Fetch the category ID for "BEAUTY TIPS"
const beautyTipsCategoryResponse = await fetch(
  `${SiteName}/wp-json/wp/v2/categories?slug=beauty-tips`
);
const beautyTipsCategory = await beautyTipsCategoryResponse.json();
const beautyTipsCategoryId = beautyTipsCategory[0].id;
const beautyTipsPostsResponse = await fetch(
  `${SiteName}/wp-json/wp/v2/posts?categories=${beautyTipsCategoryId}&_embed&per_page=3`
);
const beautyTipsPosts = await beautyTipsPostsResponse.json();

//Fetch the Category ID for "Fitness"
const fitnessCategoryResponse = await fetch(
  `${SiteName}/wp-json/wp/v2/categories?slug=fitness-and-exercise`
);	
const fitnessCategory = await fitnessCategoryResponse.json();
const fitnessCategoryId = fitnessCategory[0].id;
const fitnessPostsResponse = await fetch(
  `https://stayfreshtoday.com/wp-json/wp/v2/posts?categories=${fitnessCategoryId}&_embed&per_page=3`
);
const fitnessPosts = await fitnessPostsResponse.json();

//Fetch the Lastest 3 posts
const latestPostsResponse = await fetch(
  `${SiteName}/wp-json/wp/v2/posts?_embed&per_page=3`
);
const latestPosts = await latestPostsResponse.json();	
---

<Layout title="Beauty Tips | Skincare &amp; Haircare | Health &amp; Nutrition Tips | Stayfreshtoday.com" seoHead={seoData.head}>

  <Banner posts={posts} />
  <Categories healthPosts={healthPosts} category="Health" slug="health" color={true}/>
  <Categories healthPosts={beautyTipsPosts} category="Beauty Tips" slug="beauty-tips"/>
  <Categories healthPosts={fitnessPosts} category="Fitness & Exercise" slug="fitness-and-exercise" color={true}/>
  <Categories healthPosts={latestPosts} category="Latest Posts"  />
</Layout>