---
import Layout from "../layouts/Layout.astro";

const SiteName = import.meta.env.SITE_NAMEb || "https://admin.stayfreshtoday.com";
---

<Layout title="Newsletter" >
  <div class="px-4 sm:px-6 lg:px-8 mx-auto max-w-2xl py-12">
    <h1 class="mb-12 text-center text-4xl font-bold text-[#025831]">Newsletter</h1>

    <div>
      <form id="newsletter-form">
        <div class="flex w-full flex-col gap-4 sm:flex-row sm:gap-2">
          <input
            type="email"
            id="newsletter-email"
            name="email"
            placeholder="your@email.com"
            required
            maxlength="254"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            class="w-full rounded-lg border-0 px-3.5 py-2 shadow-sm ring-1 ring-inset sm:text-sm sm:leading-6 transition-colors duration-200 focus:outline-none bg-white dark:bg-neutral-700 placeholder:text-neutral-500 dark:placeholder:text-neutral-400 ring-neutral-300 dark:ring-neutral-700 focus:ring-2 focus:ring-blue-500 dark:focus:ring-yellow-400"
          />
         <button
  id="newsletter-submit"
  type="submit"
  class="flex items-center justify-center cursor-pointer rounded-lg px-3.5 py-2.5 text-sm font-semibold tracking-wide focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-95 transition duration-300 disabled:opacity-50 disabled:cursor-not-allowed disabled:active:scale-100 bg-[#025831] text-white shadow-sm hover:bg-[#03744a] focus-visible:outline-[#025831] active:bg-[#03744a] dark:bg-yellow-400 dark:text-black dark:shadow-[0_0_18px_-6px_rgba(251,191,36,0.12),0_0_42px_-4px_rgba(251,191,36,0.12)] dark:hover:bg-yellow-300 dark:focus-visible:outline-yellow-400 dark:active:bg-yellow-300"
>
  Subscribe
</button>
        </div>

        <p id="newsletter-message" class="mt-4 text-center text-sm"></p>

       <div class="mt-4 flex justify-center">
  <div class="max-w-xl text-center text-sm leading-relaxed text-gray-700 dark:text-gray-300">
    By subscribing, you agree to the
    <a href="/terms-and-condiitons" class="px-2 relative inline-block transition duration-250 ease-out before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 text-sm font-medium underline underline-offset-4 hover:text-[#03744A] active:text-blue-500 dark:hover:text-yellow-400 dark:active:text-yellow-400">Terms &amp; Conditions</a>
    and
    <a href="/privacy-policy" class="pl-2 relative inline-block transition duration-250 ease-out before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 text-sm font-medium underline underline-offset-4 hover:text-[#03744A] active:text-blue-500 dark:hover:text-yellow-400 dark:active:text-yellow-400">Privacy Policy</a>. You can unsubscribe at any time.
  </div>
</div>
      </form>
    </div>
  </div>
</Layout>

<script define:vars={{ SiteName }}>
  const form = document.getElementById("newsletter-form");
  const emailInput = document.getElementById("newsletter-email");
  const submitBtn = document.getElementById("newsletter-submit");
  const messageEl = document.getElementById("newsletter-message");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = emailInput.value.trim();
    if (!email) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Subscribing...";
    messageEl.textContent = "";
    messageEl.className = "mt-4 text-center text-sm";

    try {
      const baseUrl = SiteName.replace(/\/$/, "");
      const res = await fetch(`${baseUrl}/wp-json/newsletter/v1/subscribe`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        messageEl.textContent = data.message || "Successfully subscribed!";
        messageEl.classList.add("text-green-600");
        emailInput.value = "";
      } else {
        messageEl.textContent = data.message || "Something went wrong.";
        messageEl.classList.add("text-red-600");
      }
    } catch (err) {
      messageEl.textContent = "Network error. Please try again.";
      messageEl.classList.add("text-red-600");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Subscribe";
    }
  });
</script>