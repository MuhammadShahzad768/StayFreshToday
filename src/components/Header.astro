---
// Header.astro
// Update this to your WordPress REST API base URL (e.g. https://admin.yourdomain.com)
const WP_API_URL = import.meta.env.PUBLIC_WP_API_URL || "https://admin.yourdomain.com";
---

<header class="sticky top-0 z-60 border-b border-neutral-200 bg-white dark:border-neutral-700 dark:bg-neutral-900">
  <nav class="mx-auto max-w-350 px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <div class="shrink-0">
        <a href="/" class="relative inline-block transition duration-250 ease-out before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 hover:text-blue-500 active:text-blue-500 dark:hover:text-yellow-400 dark:active:text-yellow-400 text-xl font-bold">
          Stay Fresh Today
        </a>
      </div>

      <!-- Desktop nav links -->
      <div class="hidden lg:flex lg:items-center lg:space-x-8">
        <a href="/blog" class="relative inline-block before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 hover:text-blue-500 active:text-blue-500 dark:hover:text-yellow-400 dark:active:text-yellow-400 bg-[linear-gradient(currentColor,currentColor)] bg-no-repeat [background-position:0_100%] [background-size:0%_2px] transition-[background-size] duration-250 ease-out hover:[background-size:100%_2px] active:[background-size:100%_2px] group-hover:[background-size:100%_2px]">
          Blog
        </a>
        <a href="/projects" class="relative inline-block before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 hover:text-blue-500 active:text-blue-500 dark:hover:text-yellow-400 dark:active:text-yellow-400 bg-[linear-gradient(currentColor,currentColor)] bg-no-repeat [background-position:0_100%] [background-size:0%_2px] transition-[background-size] duration-250 ease-out hover:[background-size:100%_2px] active:[background-size:100%_2px] group-hover:[background-size:100%_2px]">
          Projects
        </a>
        <a href="/about-us" class="relative inline-block before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 hover:text-blue-500 active:text-blue-500 dark:hover:text-yellow-400 dark:active:text-yellow-400 bg-[linear-gradient(currentColor,currentColor)] bg-no-repeat [background-position:0_100%] [background-size:0%_2px] transition-[background-size] duration-250 ease-out hover:[background-size:100%_2px] active:[background-size:100%_2px] group-hover:[background-size:100%_2px]">
          About
        </a>
        <a href="/contact-us" class="relative inline-block before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 hover:text-blue-500 active:text-blue-500 dark:hover:text-yellow-400 dark:active:text-yellow-400 bg-[linear-gradient(currentColor,currentColor)] bg-no-repeat [background-position:0_100%] [background-size:0%_2px] transition-[background-size] duration-250 ease-out hover:[background-size:100%_2px] active:[background-size:100%_2px] group-hover:[background-size:100%_2px]">
          Contact
        </a>
        <a href="/newsletter" class="relative inline-block before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 hover:text-blue-500 active:text-blue-500 dark:hover:text-yellow-400 dark:active:text-yellow-400 bg-[linear-gradient(currentColor,currentColor)] bg-no-repeat [background-position:0_100%] [background-size:0%_2px] transition-[background-size] duration-250 ease-out hover:[background-size:100%_2px] active:[background-size:100%_2px] group-hover:[background-size:100%_2px]">
          Newsletter
        </a>

        <!-- Search trigger -->
        <button
          id="search-trigger"
          type="button"
          aria-label="Search"
          class="flex items-center gap-2 rounded-md border border-neutral-200 px-2.5 py-1.5 text-sm text-neutral-500 transition hover:border-neutral-300 hover:text-neutral-700 dark:border-neutral-700 dark:text-neutral-400 dark:hover:border-neutral-600 dark:hover:text-neutral-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
          </svg>
          <span class="hidden xl:inline">Search</span>
          <kbd class="hidden xl:inline-block rounded border border-neutral-300 bg-neutral-50 px-1.5 py-0.5 text-xs font-mono text-neutral-400 dark:border-neutral-600 dark:bg-neutral-800">⌘K</kbd>
        </button>
      </div>

      <!-- Mobile search + menu buttons -->
      <div class="flex items-center gap-2 lg:hidden">
        <button
          id="search-trigger-mobile"
          type="button"
          aria-label="Search"
          class="rounded-md p-2 text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu (unchanged) -->
    <div id="mobile-menu" class="pointer-events-none fixed top-16 right-0 bottom-0 left-0 z-50 overflow-auto" data-state="closed">
      <div class="pointer-events-auto flex flex-col space-y-1 border-b border-neutral-200 bg-white px-2 pt-2 pb-3 lg:hidden dark:border-neutral-700 dark:bg-neutral-900">
        <a href="/blog" class="border-b border-neutral-200 px-4 py-3 text-center text-lg font-medium dark:border-neutral-600">Blog</a>
        <a href="/projects" class="border-b border-neutral-200 px-4 py-3 text-center text-lg font-medium dark:border-neutral-600">Projects</a>
        <a href="/about" class="border-b border-neutral-200 px-4 py-3 text-center text-lg font-medium dark:border-neutral-600">About</a>
        <a href="/contact" class="border-b border-neutral-200 px-4 py-3 text-center text-lg font-medium dark:border-neutral-600">Contact</a>
        <a href="/newsletter" class="border-b border-neutral-200 px-4 py-3 text-center text-lg font-medium dark:border-neutral-600">Newsletter</a>
      </div>
    </div>
  </nav>

  <!-- Search modal overlay -->
  <div
    id="search-overlay"
    class="fixed inset-0 z-70 hidden items-start justify-center bg-black/50 backdrop-blur-sm px-4 pt-24"
  >
    <div
      id="search-panel"
      class="w-full max-w-xl rounded-xl border border-neutral-200 bg-white shadow-2xl dark:border-neutral-700 dark:bg-neutral-900"
    >
      <div class="flex items-center gap-3 border-b border-neutral-200 px-4 py-3 dark:border-neutral-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Search posts..."
          autocomplete="off"
          class="w-full bg-transparent text-base text-neutral-900 placeholder-neutral-400 outline-none dark:text-neutral-100"
        />
        <button id="search-close" type="button" aria-label="Close search" class="shrink-0 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div id="search-results" class="max-h-96 overflow-y-auto p-2">
        <p class="px-3 py-6 text-center text-sm text-neutral-400">Start typing to search posts</p>
      </div>
    </div>
  </div>
</header>

<script define:vars={{ WP_API_URL }}>
  const overlay = document.getElementById("search-overlay");
  const panel = document.getElementById("search-panel");
  const input = document.getElementById("search-input");
  const results = document.getElementById("search-results");
  const closeBtn = document.getElementById("search-close");
  const triggers = [
    document.getElementById("search-trigger"),
    document.getElementById("search-trigger-mobile"),
  ].filter(Boolean);

  let debounceTimer;
  let activeController;

  function openSearch() {
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    document.body.style.overflow = "hidden";
    setTimeout(() => input.focus(), 0);
  }

  function closeSearch() {
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    document.body.style.overflow = "";
    input.value = "";
    results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-neutral-400">Start typing to search posts</p>`;
  }

  triggers.forEach((btn) => btn.addEventListener("click", openSearch));
  closeBtn.addEventListener("click", closeSearch);

  overlay.addEventListener("click", (e) => {
    if (!panel.contains(e.target)) closeSearch();
  });

  document.addEventListener("keydown", (e) => {
    const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k";
    if (isCmdK) {
      e.preventDefault();
      overlay.classList.contains("hidden") ? openSearch() : closeSearch();
    }
    if (e.key === "Escape" && !overlay.classList.contains("hidden")) {
      closeSearch();
    }
  });

  function stripHtml(html) {
    const tmp = document.createElement("div");
    tmp.innerHTML = html;
    return tmp.textContent || tmp.innerText || "";
  }

  function decodeEntities(str) {
    const tmp = document.createElement("textarea");
    tmp.innerHTML = str;
    return tmp.value;
  }

  // WP's REST API returns links using whatever domain is set in
  // Settings > General on the WordPress backend. We only want the
  // path, so it resolves correctly on localhost/staging/production.
function toFrontendPath(wpLink) {
  try {
    const urlObj = new URL(wpLink);
    return `/blog${urlObj.pathname}${urlObj.search}${urlObj.hash}`;
  } catch {
    return wpLink;
  }
}

  async function runSearch(query) {
    if (activeController) activeController.abort();
    activeController = new AbortController();

    results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-neutral-400">Searching…</p>`;

    try {
      const url = `${WP_API_URL}/wp-json/wp/v2/posts?search=${encodeURIComponent(
        query
      )}&per_page=6&_fields=id,title,excerpt,link,date`;
      const res = await fetch(url, { signal: activeController.signal });
      if (!res.ok) throw new Error("Search request failed");
      const posts = await res.json();

      if (!Array.isArray(posts) || posts.length === 0) {
        results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-neutral-400">No results for "${query}"</p>`;
        return;
      }

      results.innerHTML = posts
        .map((post) => {
          const title = decodeEntities(post.title?.rendered || "Untitled");
          const excerpt = stripHtml(post.excerpt?.rendered || "").trim().slice(0, 120);
          const date = post.date
            ? new Date(post.date).toLocaleDateString(undefined, {
                year: "numeric",
                month: "short",
                day: "numeric",
              })
            : "";
          const href = toFrontendPath(post.link);
          return `
            <a href="${href}" class="block rounded-lg px-3 py-2.5 hover:bg-neutral-100 dark:hover:bg-neutral-800">
              <p class="text-sm font-medium text-neutral-900 dark:text-neutral-100">${title}</p>
              <p class="mt-0.5 line-clamp-1 text-xs text-neutral-500 dark:text-neutral-400">${excerpt}${excerpt.length === 120 ? "…" : ""}</p>
              ${date ? `<p class="mt-1 text-[11px] text-neutral-400 dark:text-neutral-500">${date}</p>` : ""}
            </a>
          `;
        })
        .join("");
    } catch (err) {
      if (err.name === "AbortError") return;
      results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-red-500">Something went wrong. Try again.</p>`;
    }
  }

  input.addEventListener("input", () => {
    const query = input.value.trim();
    clearTimeout(debounceTimer);

    if (!query) {
      results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-neutral-400">Start typing to search posts</p>`;
      return;
    }

    debounceTimer = setTimeout(() => runSearch(query), 300);
  });
</script>