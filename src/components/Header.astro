---
// Header.astro
// Update this to your WordPress REST API base URL (e.g. https://admin.yourdomain.com)
const WP_API_URL = import.meta.env.PUBLIC_WP_API_URL || "https://admin.yourdomain.com";

// ---------- Active link detection ----------
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navLinks = [
  { href: "/blog", label: "Blog" },
  { href: "/about-us", label: "About" },
  { href: "/contact-us", label: "Contact" },
  { href: "/newsletter", label: "Newsletter" },
  { href: "/usa-air-quality", label: "Air Quality" },
];

// Matches exact path, or any sub-path under it (e.g. /blog/my-post is "active" for /blog)
function isActive(href) {
  const cleanHref = href.replace(/\/+$/, "") || "/";
  if (cleanHref === "/") return currentPath === "/";
  return currentPath === cleanHref || currentPath.startsWith(cleanHref + "/");
}

// Shared "hover" look, reused as the permanent active state
const activeClasses = "text-[#025831] dark:text-yellow-400 [background-size:100%_2px]";
---

<header class="sticky top-0 z-[60] border-b border-neutral-200 bg-white dark:border-neutral-700 dark:bg-neutral-900 py-4 ">
  <div class="header-container">
  <nav class="mx-auto w-full px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <div class="shrink-0">
        <a href="/" class="relative inline-block transition duration-250 ease-out before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 hover:text-[#025831] active:text-blue-500 dark:hover:text-yellow-400 dark:active:text-yellow-400 text-xl font-bold">
          <img src="https://stayfreshtoday.com/wp-content/uploads/2025/12/cropped-stayfreshtoday-192x192.png" alt="StayFreshToday" class="w-[48px] h-[48px] sm:w-[60px] sm:h-[60px] inline-block mr-2 object-contain" />
        </a>
      </div>

      <!-- Desktop nav links -->
      <div class="hidden lg:flex lg:items-center lg:space-x-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "relative inline-block before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 hover:text-[#025831] active:text-[#025831] dark:hover:text-yellow-400 dark:active:text-yellow-400 bg-[linear-gradient(currentColor,currentColor)] bg-no-repeat [background-position:0_100%] [background-size:0%_2px] transition-[background-size] duration-250 ease-out hover:[background-size:100%_2px] active:[background-size:100%_2px] group-hover:[background-size:100%_2px]",
              isActive(link.href) && activeClasses,
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}

        <!-- Search trigger -->
        <button
          id="search-trigger"
          type="button"
          aria-label="Search"
          class="flex items-center gap-2 rounded-md border border-neutral-200 px-2.5 py-1.5 text-sm text-neutral-500 transition hover:border-neutral-300 hover:text-neutral-700 dark:border-neutral-700 dark:text-neutral-400 dark:hover:border-neutral-600 dark:hover:text-neutral-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
          </svg>
          <span class="hidden xl:inline">Search</span>
          <kbd class="hidden xl:inline-block rounded border border-neutral-300 bg-neutral-50 px-1.5 py-0.5 text-xs font-mono text-neutral-400 dark:border-neutral-600 dark:bg-neutral-800">⌘K</kbd>
        </button>
      </div>

      <!-- Mobile: search + hamburger -->
      <div class="flex items-center gap-1 lg:hidden">
        <button
          id="search-trigger-mobile"
          type="button"
          aria-label="Search"
          class="rounded-md p-2 text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
          </svg>
        </button>

        <button
          id="menu-toggle"
          type="button"
          aria-label="Toggle menu"
          aria-expanded="false"
          class="rounded-md p-2 text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white"
        >
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="pointer-events-none fixed inset-x-0 top-16 bottom-0 z-50 overflow-auto opacity-0 hidden -translate-y-2 transition-all duration-200 ease-out lg:hidden"
    >
      <div class="pointer-events-auto flex flex-col space-y-1 border-b border-neutral-200 bg-white px-2 pt-2 pb-3 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 width-[100%]" style="width: 100%;">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "border-b border-neutral-200 px-4 py-3 text-center text-lg font-medium dark:border-neutral-700",
              isActive(link.href) && "text-[#025831] dark:text-yellow-400",
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Search modal overlay -->
  <div
    id="search-overlay"
    class="fixed inset-0 z-[70] hidden items-start justify-center bg-black/50 backdrop-blur-sm px-4 pt-24"
  >
    <div
      id="search-panel"
      class="w-full max-w-xl rounded-xl border border-neutral-200 bg-white shadow-2xl dark:border-neutral-700 dark:bg-neutral-900"
    >
      <div class="flex items-center gap-3 border-b border-neutral-200 px-4 py-3 dark:border-neutral-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Search posts..."
          autocomplete="off"
          class="w-full bg-transparent text-base text-neutral-900 placeholder-neutral-400 outline-none dark:text-neutral-100"
        />
        <button id="search-close" type="button" aria-label="Close search" class="shrink-0 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div id="search-results" class="max-h-96 overflow-y-auto p-2">
        <p class="px-3 py-6 text-center text-sm text-neutral-400">Start typing to search posts</p>
      </div>
    </div>
  </div>
  </div>
</header>

<script define:vars={{ WP_API_URL }}>
  // ---------- Mobile hamburger menu ----------
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIconOpen = document.getElementById("menu-icon-open");
  const menuIconClose = document.getElementById("menu-icon-close");
  let menuOpen = false;

  function setMenu(open) {
    menuOpen = open;
    menuToggle.setAttribute("aria-expanded", String(open));
    menuIconOpen.classList.toggle("hidden", open);
    menuIconClose.classList.toggle("hidden", !open);

    if (open) {
      mobileMenu.classList.remove("pointer-events-none", "opacity-0", "-translate-y-2","hidden");
      mobileMenu.classList.add("pointer-events-auto", "opacity-100", "translate-y-0","flex","width-[100%]");
      document.body.style.overflow = "hidden";
    } else {
      mobileMenu.classList.add("pointer-events-none", "opacity-0", "-translate-y-2","hidden");
      mobileMenu.classList.remove("pointer-events-auto", "opacity-100", "translate-y-0","flex","width-[100%]");
      document.body.style.overflow = "";
    }
  }

  menuToggle.addEventListener("click", () => setMenu(!menuOpen));

  // Close mobile menu when a link inside it is tapped
  mobileMenu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  // Close mobile menu on resize up to desktop breakpoint
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024 && menuOpen) setMenu(false);
  });

  // ---------- Search modal ----------
  const overlay = document.getElementById("search-overlay");
  const panel = document.getElementById("search-panel");
  const input = document.getElementById("search-input");
  const results = document.getElementById("search-results");
  const closeBtn = document.getElementById("search-close");
  const triggers = [
    document.getElementById("search-trigger"),
    document.getElementById("search-trigger-mobile"),
  ].filter(Boolean);

  let debounceTimer;
  let activeController;

  function openSearch() {
    if (menuOpen) setMenu(false);
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    document.body.style.overflow = "hidden";
    setTimeout(() => input.focus(), 0);
  }

  function closeSearch() {
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    document.body.style.overflow = "";
    input.value = "";
    results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-neutral-400">Start typing to search posts</p>`;
  }

  triggers.forEach((btn) => btn.addEventListener("click", openSearch));
  closeBtn.addEventListener("click", closeSearch);

  overlay.addEventListener("click", (e) => {
    if (!panel.contains(e.target)) closeSearch();
  });

  document.addEventListener("keydown", (e) => {
    const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k";
    if (isCmdK) {
      e.preventDefault();
      overlay.classList.contains("hidden") ? openSearch() : closeSearch();
    }
    if (e.key === "Escape") {
      if (!overlay.classList.contains("hidden")) closeSearch();
      if (menuOpen) setMenu(false);
    }
  });

  function stripHtml(html) {
    const tmp = document.createElement("div");
    tmp.innerHTML = html;
    return tmp.textContent || tmp.innerText || "";
  }

  function decodeEntities(str) {
    const tmp = document.createElement("textarea");
    tmp.innerHTML = str;
    return tmp.value;
  }

  // WP's REST API returns links using whatever domain is set in
  // Settings > General on the WordPress backend. We only want the
  // path, so it resolves correctly on localhost/staging/production.
  function toFrontendPath(wpLink) {
    try {
      const urlObj = new URL(wpLink);
      return `/blog${urlObj.pathname}${urlObj.search}${urlObj.hash}`;
    } catch {
      return wpLink;
    }
  }

  async function runSearch(query) {
    if (activeController) activeController.abort();
    activeController = new AbortController();

    results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-neutral-400">Searching…</p>`;

    try {
      const url = `${WP_API_URL}/wp-json/wp/v2/posts?search=${encodeURIComponent(
        query
      )}&per_page=6&_fields=id,title,excerpt,link,date`;
      const res = await fetch(url, { signal: activeController.signal });
      if (!res.ok) throw new Error("Search request failed");
      const posts = await res.json();

      if (!Array.isArray(posts) || posts.length === 0) {
        results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-neutral-400">No results for "${query}"</p>`;
        return;
      }

      results.innerHTML = posts
        .map((post) => {
          const title = decodeEntities(post.title?.rendered || "Untitled");
          const excerpt = stripHtml(post.excerpt?.rendered || "").trim().slice(0, 120);
          const date = post.date
            ? new Date(post.date).toLocaleDateString(undefined, {
                year: "numeric",
                month: "short",
                day: "numeric",
              })
            : "";
          const href = toFrontendPath(post.link);
          return `
            <a href="${href}" class="block rounded-lg px-3 py-2.5 hover:bg-neutral-100 dark:hover:bg-neutral-800">
              <p class="text-sm font-medium text-neutral-900 dark:text-neutral-100">${title}</p>
              <p class="mt-0.5 line-clamp-1 text-xs text-neutral-500 dark:text-neutral-400">${excerpt}${excerpt.length === 120 ? "…" : ""}</p>
              ${date ? `<p class="mt-1 text-[11px] text-neutral-400 dark:text-neutral-500">${date}</p>` : ""}
            </a>
          `;
        })
        .join("");
    } catch (err) {
      if (err.name === "AbortError") return;
      results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-red-500">Something went wrong. Try again.</p>`;
    }
  }

  input.addEventListener("input", () => {
    const query = input.value.trim();
    clearTimeout(debounceTimer);

    if (!query) {
      results.innerHTML = `<p class="px-3 py-6 text-center text-sm text-neutral-400">Start typing to search posts</p>`;
      return;
    }

    debounceTimer = setTimeout(() => runSearch(query), 300);
  });

  // ---------- Scroll shadow (fixed: no more inline width hacks) ----------
  const headerEl = document.querySelector("header");
  window.addEventListener("scroll", () => {
    headerEl.classList.toggle("shadow-md", window.scrollY > 0);
  });
</script>

<style is:global>
  .header-container {
    max-width: 1150px;
    margin: auto;
    width: 95%;
  }
 
</style>