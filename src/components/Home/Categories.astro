---
const { healthPosts, category, slug, color } = Astro.props;
import { decode } from "html-entities";
---

<section
  class:list={[
    "relative overflow-hidden",
    color
      ? "text-white bg-[#6AB491]  py-10"
      : "text-[#025831]  py-10  ",
  ]}
> 
  <div class='max-w-7xl m-auto px-[20px]  sm:px-6 lg:px-8 '>
    <div class="mb-12 flex items-center justify-between">
      <h2 class="text-xl xl:text-3xl font-bold">{category}</h2> 
      {slug && (
        <a href=`/category/${slug}`     
         class:list={[
    "relative inline-block transition duration-250 ease-out before:content-[''] before:absolute before:inset-y-[-10px] before:inset-x-[-7px] active:scale-95 text-sm xl:text-lg font-bold  underline-offset-4 underline decoration-transparent hover:decoration-current active:decoration-current ",
    color
      ? "text-[#fff]"
      : "text-[#025831]",
  ]}
        class=""> View all posts &rarr; </a> 
      )}
    </div>

    <!-- Desktop: normal grid -->
    <div class="hidden lg:grid grid-cols-3 gap-x-8 gap-y-10">
      {healthPosts.map((post) => (
        <article class="group relative flex flex-col">
          <div class="relative overflow-hidden bg-neutral-200  mb-4 aspect-video rounded-lg">
            <img
              class="absolute inset-0 h-full w-full object-cover transition duration-250 ease-out group-hover:scale-105"
              alt={post._embedded["wp:featuredmedia"][0].alt_text}
              loading="lazy"
              sizes="33vw"
              decoding="async"
              src={post._embedded["wp:featuredmedia"][0].source_url}
            >
          </div>
          <h3 class="mb-2 line-clamp-2 text-xl font-semibold transition-colors duration-250 ease-out group-hover:text-[#025831] group-hover:underline group-hover:decoration-[#025831]">
            <a
  href={`/blog/${post.slug}`}
  class="after:absolute after:inset-0 after:content-['']"
  title={decode(post.title.rendered)}
>
  {decode(post.title.rendered)}
</a>
          </h3>
          <p class:list={["line-clamp-3", color ? "text-white" : "text-gray-700 "]}>
            {post.excerpt.rendered.replace(/<[^>]*>/g, '').split(' ').slice(0, 10).join(' ')}...
          </p>
          <div class="mt-3.5 flex flex-col items-start gap-y-4">
            <div class:list={["flex items-center gap-x-2 text-sm", color ? "text-white" : "text-gray-700 "]}>
              <time>{new Date(post.date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Mobile: Swiper slider -->
    <div class="lg:hidden">
      <div class="swiper healthPostsSwiper">
        <div class="swiper-wrapper">
          {healthPosts.map((post) => (
            <div class="swiper-slide">
              <article class="group relative flex flex-col">
                <div class="relative overflow-hidden bg-neutral-200  mb-4 aspect-video rounded-lg">
                  <img
                    class="absolute inset-0 h-full w-full object-cover"
                    alt={post._embedded["wp:featuredmedia"][0].alt_text}
                    loading="lazy"
                    sizes="100vw"
                    decoding="async"
                    src={post._embedded["wp:featuredmedia"][0].source_url}
                  >
                </div>
                <h3 class="mb-2 line-clamp-2 text-xl font-semibold">
                  <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0 after:content-['']" title={post.title.rendered}>{post.title.rendered}</a>
                </h3>
                <p class:list={["line-clamp-3", color ? "text-white" : "text-gray-700 "]}>
                  {post.excerpt.rendered.replace(/<[^>]*>/g, '').split(' ').slice(0, 10).join(' ')}...
                </p>
                <div class="mt-3.5 flex flex-col items-start gap-y-4">
                  <div class:list={["flex items-center gap-x-2 text-sm", color ? "text-white" : "text-gray-700 "]}>
                    <time>{new Date(post.date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>

  </div>
</section>

<style>
  .healthPostsSwiper {
    padding-bottom: 40px !important;
    overflow: visible;
  }
  .healthPostsSwiper .swiper-slide {
    width: 100%;
  }
  @media (min-width: 640px) {
    .healthPostsSwiper .swiper-slide {
      width: 60%;
    }
  }
  .swiper-pagination-bullet {
    background: #025831;
    opacity: 0.4;
  }
  .swiper-pagination-bullet-active {
    opacity: 1;
  }
 div[class~="max-w-7xl"][class~="m-auto"][class~="px-[20px]"][class~="xl:px-0"] {
  overflow: hidden;
}
</style>

<script>
  import Swiper from "swiper";
  import { Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  new Swiper(".healthPostsSwiper", {
    modules: [Pagination],
    slidesPerView: "auto",
    spaceBetween: 16,
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
  });
  
  function decodeHTML(html) {
    const txt = document.createElement("textarea");
    txt.innerHTML = html;
    return txt.value;
  }
  
</script>