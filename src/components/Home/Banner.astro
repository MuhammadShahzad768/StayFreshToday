---
const { posts } = Astro.props;

const getImage = (post, size = "large") => {
  const media = post?._embedded?.["wp:featuredmedia"]?.[0];

  return (
    media?.media_details?.sizes?.[size]?.source_url ||
    media?.source_url ||
    ""
  );
};

const getAlt = (post) => {
  return post?._embedded?.["wp:featuredmedia"]?.[0]?.alt_text ||
    post?.title?.rendered ||
    "";
};
---

<div class="max-w-7xl px-4 sm:px-6 lg:px-8 m-auto grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-1 md:gap-3 lg:grid-cols-3 lg:gap-6 mb-10">

  <!-- Main Featured Post -->
  <div class="lg:col-span-2">

    <a
      href={`/blog/${posts[0].slug}`}
      class="relative items-center p-1 flex justify-center overflow-hidden group rounded-xl aspect-video md:aspect-auto h-full card-hover-effect card-size-large"
    >

      <div
        class="relative overflow-hidden bg-neutral-200 h-full w-full z-10 rounded-[0.625rem] bg-cover bg-center bg-no-repeat transition-transform duration-500 ease-out group-hover:scale-105 bg-images"
        style={`background-image: url('${getImage(posts[0], "large")}')`}
      >
      </div>

      <!-- Category -->
      <span
        class="absolute top-0 left-0 z-50 m-2 inline-block rounded-md bg-black/70 px-3 py-1.5 text-xs font-medium text-white capitalize sm:text-sm md:m-2.5"
      >
        {posts[0]?._embedded?.["wp:term"]?.[0]?.[0]?.name}
      </span>

      <!-- Content -->
      <div
        class="absolute inset-x-0 bottom-0 m-2 md:m-2.5 z-20 rounded-lg bg-black/75 px-3 py-2 sm:px-4 sm:py-2.5 md:px-6 md:py-4"
      >

        <h3
          class="line-clamp-1 font-bold text-white sm:mb-2 text-lg sm:text-2xl md:text-3xl"
        >
          {posts[0].title.rendered}
        </h3>

        <span
          class="text-gray-200 hidden sm:line-clamp-2 lg:line-clamp-3 sm:text-base lg:text-lg"
          set:html={posts[0].excerpt.rendered}
        ></span>

      </div>

    </a>

  </div>


  <!-- Small Posts -->
  <div class="flex flex-col gap-4 sm:gap-5 md:gap-3.5 lg:gap-3">

    {posts.slice(1, 3).map((post) => (

      <a
        href={`/blog/${post.slug}`}
        class="relative items-center p-1 flex justify-center overflow-hidden group rounded-xl aspect-video card-hover-effect card-size-small"
      >

        <div class="relative overflow-hidden bg-neutral-200 h-full w-full z-10 rounded-[0.625rem]">

          <img
            class="absolute inset-0 h-full w-full object-cover block transform-gpu will-change-transform transition-transform duration-500 ease-out group-hover:scale-105"
            src={getImage(post, "medium_large")}
            alt={getAlt(post)}
            loading="lazy"
            decoding="async"
            width="768"
            height="432"
          />

        </div>

        <!-- Category -->
        <span
          class="absolute top-0 left-0 z-50 m-2 inline-block rounded-md bg-black/70 px-3 py-1.5 text-xs font-medium text-white capitalize sm:text-sm md:m-2.5"
        >
          {post?._embedded?.["wp:term"]?.[0]?.[0]?.name}
        </span>

        <!-- Content -->
        <div
          class="absolute inset-x-0 bottom-0 m-2 md:m-2.5 z-20 rounded-lg bg-black/75 px-3 py-2 sm:px-4 sm:py-2.5"
        >

          <h3
            class="line-clamp-1 font-bold text-white sm:mb-2 text-lg sm:text-2xl md:text-lg text-[20px]"
          >
            {post.title.rendered}
          </h3>

          <p class="text-gray-200 hidden sm:line-clamp-2 lg:line-clamp-3 sm:text-base lg:text-lg">
            {post.excerpt.rendered
              .replace(/<[^>]*>/g, "")
              .split(" ")
              .slice(0, 10)
              .join(" ")}...
          </p>

        </div>

      </a>

    ))}

  </div>

</div>

<style>
  .bg-images {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>