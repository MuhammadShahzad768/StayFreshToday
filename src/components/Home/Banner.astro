
---
const { posts } = Astro.props;
---
<div class="grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 md:gap-3 lg:grid-cols-3 lg:gap-6"> <div class="lg:col-span-2"> <a href=`/blog/${posts[0].slug}` class="relative items-center p-1 flex justify-center overflow-hidden group rounded-xl aspect-video md:aspect-auto h-full card-hover-effect card-size-large" data-astro-cid-upkumhrg=""> <div class="relative overflow-hidden bg-neutral-200 dark:bg-neutral-700 h-full w-full z-10 rounded-[0.625rem]"> <img data-pagefind-ignore="" src="https://res.cloudinary.com/dellp9a4z/image/upload/w_20,e_blur:1000,q_1,f_auto/v1756653540/why_most_fail_at_marketing_iropjm.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-105 object-cover blur-xl block transform-gpu will-change-transform backface-hidden transition-transform duration-500 ease-out group-hover:scale-105" loading="eager" decoding="async"> <img class="astro-cloudinary-cldimage absolute inset-0 h-full w-full object-cover block transform-gpu will-change-transform backface-hidden transition-transform duration-500 ease-out group-hover:scale-105" alt="A hand-drawn illustration of a marketing funnel showing why people fail at marketing. Stylized figures fall off the side of the cracked funnel, with labels pointing out the mistakes: 'Pitching too early,' 'No trust,' and 'No value." loading="eager" fetchpriority="high" data-astro-cid-upkumhrg="true" data-cldimage-src="https://res.cloudinary.com/dellp9a4z/image/upload/v1756653540/why_most_fail_at_marketing_iropjm.webp" decoding="async" sizes="(min-width: 1600px) 1600px, 100vw" style="object-fit:cover;max-width:1600px;max-height:900px;aspect-ratio:1.7777777777777777;width:100%" src={posts[0]._embedded["wp:featuredmedia"][0].source_url}> </div> <span class="absolute top-0 left-0 z-50 m-2 inline-block rounded-md bg-black/70 px-3 py-1.5 text-xs font-medium text-white capitalize sm:text-sm md:m-2.5" data-astro-cid-upkumhrg="">{posts[0]._embedded?.["wp:term"]?.[0]?.[0]?.name}</span> <div class="absolute inset-x-0 bottom-0 m-2 md:m-2.5 z-20 rounded-lg md:rounded-lg bg-black/75 px-3 py-2 sm:px-4 sm:py-2.5 md:px-6 md:py-4" data-astro-cid-upkumhrg=""> <h3 class="line-clamp-1 font-bold text-white sm:mb-2 text-lg sm:text-2xl md:text-3xl" data-astro-cid-upkumhrg="">{posts[0].title.rendered}</h3>
      <span class="text-gray-200 hidden sm:line-clamp-2 lg:line-clamp-3 sm:text-base lg:text-lg" set:html={posts[0].excerpt.rendered}></span>
 </div> </a> </div>
  <div class="flex flex-col gap-4 sm:gap-5 md:gap-3.5 lg:gap-6"> 
    {posts.slice(1,3).map((post) => (
    <a href=`/blog/${post.slug}` class="relative items-center p-1 flex justify-center overflow-hidden group rounded-xl aspect-video card-hover-effect card-size-small" data-astro-cid-upkumhrg=""> <div class="relative overflow-hidden bg-neutral-200 dark:bg-neutral-700 h-full w-full z-10 rounded-[0.625rem]"> <img data-pagefind-ignore="" src="https://res.cloudinary.com/dellp9a4z/image/upload/w_20,e_blur:1000,q_1,f_auto/v1756653612/offer_pbtewp.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-105 object-cover blur-xl block transform-gpu will-change-transform backface-hidden transition-transform duration-500 ease-out group-hover:scale-105" loading="eager" decoding="async"> <img class="astro-cloudinary-cldimage absolute inset-0 h-full w-full object-cover block transform-gpu will-change-transform backface-hidden transition-transform duration-500 ease-out group-hover:scale-105" alt="A hand-drawn charcoal sketch on textured brown paper. The illustration depicts a chasm separating two cliffs. On the left cliff, labeled 'PROBLEM', a sad cartoon character stands under a rain cloud. On the right cliff, labeled 'OUTCOME', a happy sun shines. In the middle, a helpful character is finishing a rope bridge, which has a wooden sign hanging from it that reads 'YOUR OFFER'." loading="eager" fetchpriority="high" data-astro-cid-upkumhrg="true"  decoding="async" sizes="(min-width: 1600px) 1600px, 100vw" style="object-fit:cover;max-width:1600px;max-height:900px;aspect-ratio:1.7777777777777777;width:100%"  src={post._embedded["wp:featuredmedia"][0].source_url}>  </div> <span class="absolute top-0 left-0 z-50 m-2 inline-block rounded-md bg-black/70 px-3 py-1.5 text-xs font-medium text-white capitalize sm:text-sm md:m-2.5" data-astro-cid-upkumhrg=""><span>
  {post._embedded?.["wp:term"]?.[0]?.[0]?.name}
</span> </span> <div class="absolute inset-x-0 bottom-0 m-2 md:m-2.5 z-20 rounded-lg md:rounded-lg bg-black/75 px-3 py-2 sm:px-4 sm:py-2.5" data-astro-cid-upkumhrg=""> <h3 class="line-clamp-1 font-bold text-white sm:mb-2 text-lg sm:text-2xl md:text-xl" data-astro-cid-upkumhrg="">{post.title.rendered}</h3>
<span>
   <p class="text-gray-200 hidden sm:line-clamp-2 lg:line-clamp-3 sm:text-base lg:text-lg">
  {post.excerpt.rendered
    .replace(/<[^>]*>/g, '')
    .split(' ')
    .slice(0, 10)
    .join(' ')}...
</p>
</span>
 </div> </a>    
))} 

</div> 
</div>