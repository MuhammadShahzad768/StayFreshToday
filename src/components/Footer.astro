    <style is:global>
        .main-footer {
    background-color: #000;
}
.footer-container {
    max-width: 1150px;
    margin: auto;
    width: 95%;
    padding-top: 50px;
    padding-bottom: 50px;
}
.row.flex {
    gap: 10px;
    flex-wrap: nowrap;
}
.tabrow:first-child {
    width: 31%;
}
.inner-tab {
    width: 85% !important;
}
.main-footer h2 {
    color: #fff;
    font-size: 30px;
    line-height: 18px;
    font-weight: 700;
    margin-bottom: 30px;
    margin-top: 0;
}
h2 {
    margin-top: 0 !important;
}
#text-2 {
    padding-bottom: 0;
    margin-bottom: 0;
    padding-top: 0;
}
.footer-container p {
    letter-spacing: 1.3px;
    font-weight: 400;
    font-family: Poppins, sans-serif;
    font-size: 14px;
    margin-top: 0;
    line-height: 22px;
    color: #fff;
    margin-bottom: 7px;
}
section#text-2 p:not(:first-of-type) {
    width: 100%;
    display: flex;
    gap: 10px;
}

.textwidget p:nth-child(2) {
    margin-top: 20px;
}
.main-footer img {
    width: 25px;
    height: 25px;
    filter: brightness(0) invert(1);
}
.tabrow:nth-child(2) {
    width: 21%;
}
section#nav_menu-6, #nav_menu-5 {
    padding: 0;
    background-color: transparent !important;
}
.td-blog-fitness .widget_nav_menu {
    text-align: center;
    background-color: #f1f1f1;
    padding: 30px;
    margin-bottom: 48px;
}
.menu-quick_links-container {
    display: flex;
}
.td-blog-fitness .widget_nav_menu ul

 {
    display: inline-block;
}

.widget ul {
    list-style: none;
    box-shadow: none;
}
.main-footer ul {
    margin-top: 0;
    color: #fff;
    padding-left: 0;
    margin-left: 0;
    list-style: none;
}
.main-footer ul li {
    display: flex;
    line-height: 30px;
    float: none !important;
    font-size: 17px !important;
    font-family: Poppins, sans-serif;
    width: 100%;
    margin-left: 0 !important;
    margin: 15px 0;
}
.tabrow:nth-child(3) {
    width: 27%;
}
.tabrow:nth-child(4) {
    margin-left: auto;
    width: 16%;
}
section#simple-social-icons-2 {
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;
}

#simple-social-icons-2 {
    margin-top: 0;
    padding-top: 0;
}
#simple-social-icons-2 ul.alignleft {
    display: flex;
}
.simple-social-icons ul li {
    background: none !important;
    border: none !important;
    float: left;
    list-style-type: none !important;
    margin: 0 6px 12px !important;
    padding: 0 !important;
}
#simple-social-icons-2 ul li a, #simple-social-icons-2 ul li a:hover, #simple-social-icons-2 ul li a:focus {
    background-color: #025831 !important;
    border-radius: 3px;
    color: #ffffff !important;
    border: 0px #ffffff solid !important;
    font-size: 18px;
    padding: 9px;
}
.simple-social-icons svg[class^="social-"], .simple-social-icons svg[class*=" social-"] {
    display: inline-block;
    width: 1em;
    height: 1em;
    stroke-width: 0;
    stroke:#fff;
    fill: #fff;
}
#simple-social-icons-2 ul li a, #simple-social-icons-2 ul li a:hover, #simple-social-icons-2 ul li a:focus {
    border-radius: 50px !important;
}
.simple-social-icons ul li a {
    border: none !important;
    -moz-box-sizing: content-box;
    -webkit-box-sizing: content-box;
    box-sizing: content-box;
    display: inline-block;
    font-style: normal !important;
    font-variant: normal !important;
    font-weight: normal !important;
    height: 1em;
    line-height: 1em;
    text-align: center;
    text-decoration: none !important;
    text-transform: none !important;
    width: 1em;
}
.alignleft {
    float: left;
    margin-top: 6px;
    margin-right: 24px !important;
    margin-bottom: 6px !important;
    margin-left: 0;
}

.footer_bottom {
    background: #025831;
    color: #fff;
    padding: 20px 0;
    text-align: center;
}
.custom_container {
    max-width: 1170px;
    margin: 0 auto;
    padding: 0 20px;
}
.copy_right {
    justify-content: space-between;
    flex-flow: wrap;
    grid-gap: 10px;
    align-items: center;
}
p.ppa {
    margin-bottom: 0 !important;
}
@media screen and (min-width: 320px) and (max-width: 768px) {

    .tabrow{
        width: 100% !important;
    }

    .footer-container .row.flex {
        flex-wrap: wrap;
        max-width: 90%;
        margin: auto;
    }
}
</style>