<div class="tabrow">

 <h2>Recent Posts</h2>

<ul class="footer-posts">
  {posts.map((post) => (
    <li>
      <a
        href={`/blog/${post.slug}/`}
        class="achor_tag_link"
      >
        {post.title.rendered}
      </a>
    </li>
  ))}
</ul>
</div>
        <div class="tabrow">

              <h2>Categories</h2><section id="nav_menu-5" class="td_block_template_1 widget widget_nav_menu"><div class="menu-footer_categories-container"><ul id="menu-footer_categories" class="menu"><li id="menu-item-1230" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-first td-menu-item td-normal-menu menu-item-1230"><a href="/category/health/">Health</a></li>
