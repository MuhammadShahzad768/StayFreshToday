---
const { title = "My Astro Website",seoHead } = Astro.props;
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  
    <Fragment set:html={seoHead} />
 
  <title>{title}</title>
</head>

<body>

  <Header />
  <main id="main" class="min-h-[calc(100vh-12rem)]">
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-24 py-12'>
      <slot />
    </div>
  </main>
  <Footer />

</body>
</html>