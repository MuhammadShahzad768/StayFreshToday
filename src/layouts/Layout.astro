---
const { title = "My Astro Website",seoHead } = Astro.props;
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import '../styles/global.css';
import ScrollToTopAstroComponent from "../components/scroll-to-top.astro";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
    <Fragment set:html={seoHead} />
 <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="icon" href="https://stayfreshtoday.com/wp-content/uploads/2025/12/cropped-stayfreshtoday-192x192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="https://stayfreshtoday.com/wp-content/uploads/2025/12/cropped-stayfreshtoday-180x180.png" />
<meta name="msapplication-TileImage" content="https://stayfreshtoday.com/wp-content/uploads/2025/12/cropped-stayfreshtoday-270x270.png" />
<link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap" rel="stylesheet">
  <title>{title}</title>
<script 
  async 
  src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-ca-pub-6241124447573628"
  crossorigin="anonymous">
</script>
   <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

<body>
  <Header />
  <main id="main" class="min-h-[calc(100vh-12rem)] td-blog-fitness">
    <div class='mx-auto py-12'>
      <ScrollToTopAstroComponent/>
      <slot />
    </div>
  </main>
  <Footer />

</body>
</html>